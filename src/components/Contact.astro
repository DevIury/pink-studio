---
/* src/components/Contact.astro */
import SectionTitle from './ui/SectionTitle.astro';
import { LINKS, SITE } from '@/config';
---

<section id="contato" class="relative overflow-hidden py-20 md:py-28 lg:py-32">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -top-40 left-1/2 h-[32rem] w-[32rem] -translate-x-1/2 rounded-full bg-accent/10 blur-[140px]" />
    <div class="noise-overlay" />
  </div>

  <div class="container-site relative z-10">
    <SectionTitle
      eyebrow="Contato"
      title="Vamos conversar?"
      description="Preencha o formulário ou entre em contato pelo WhatsApp. Respondemos em até 24 horas."
    />

    <div class="mx-auto mt-16 grid gap-12 lg:grid-cols-2 lg:gap-16">
      <form id="contact-form" class="space-y-6" action="#" method="POST">
        <div>
          <label for="name" class="mb-2 block text-sm font-medium text-content-secondary">Nome</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-white placeholder-content-secondary/50 backdrop-blur-sm transition-colors focus:border-accent/50 focus:outline-none focus:ring-1 focus:ring-accent/50"
            placeholder="Seu nome"
          />
        </div>

        <div>
          <label for="email" class="mb-2 block text-sm font-medium text-content-secondary">E-mail</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-white placeholder-content-secondary/50 backdrop-blur-sm transition-colors focus:border-accent/50 focus:outline-none focus:ring-1 focus:ring-accent/50"
            placeholder="seu@email.com"
          />
        </div>

        <div>
          <label for="service" class="mb-2 block text-sm font-medium text-content-secondary">Serviço</label>
          <select
            id="service"
            name="service"
            class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-white backdrop-blur-sm transition-colors focus:border-accent/50 focus:outline-none focus:ring-1 focus:ring-accent/50"
          >
            <option value="" class="bg-base-surface">Selecione um serviço</option>
            <option value="social-media" class="bg-base-surface">Social Media</option>
            <option value="video" class="bg-base-surface">Produção de Vídeo</option>
            <option value="branding" class="bg-base-surface">Branding</option>
            <option value="eventos" class="bg-base-surface">Cobertura de Eventos</option>
            <option value="outro" class="bg-base-surface">Outro</option>
          </select>
        </div>

        <div>
          <label for="message" class="mb-2 block text-sm font-medium text-content-secondary">Mensagem</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="w-full resize-none rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-white placeholder-content-secondary/50 backdrop-blur-sm transition-colors focus:border-accent/50 focus:outline-none focus:ring-1 focus:ring-accent/50"
            placeholder="Conte-nos sobre seu projeto..."
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full rounded-xl bg-gradient-to-r from-accent to-[#1a1a1a] px-6 py-3.5 text-sm font-semibold text-white transition-all hover:shadow-glow"
        >
          Enviar mensagem
        </button>
      </form>

      <div class="flex flex-col justify-center gap-8">
        <div class="glass rounded-2xl p-6">
          <div class="flex items-start gap-4">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </span>
            <div>
              <h3 class="font-semibold text-white">WhatsApp</h3>
              <a href={LINKS.whatsapp} target="_blank" rel="noopener noreferrer" class="text-sm text-content-secondary hover:text-accent transition-colors">
                {SITE.whatsapp}
              </a>
            </div>
          </div>
        </div>

        <div class="glass rounded-2xl p-6">
          <div class="flex items-start gap-4">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </span>
            <div>
              <h3 class="font-semibold text-white">E-mail</h3>
              <a href={`mailto:${SITE.email}`} class="text-sm text-content-secondary hover:text-accent transition-colors">
                {SITE.email}
              </a>
            </div>
          </div>
        </div>

        <div class="glass rounded-2xl p-6">
          <div class="flex items-start gap-4">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <div>
              <h3 class="font-semibold text-white">Localização</h3>
              <p class="text-sm text-content-secondary">{SITE.location}</p>
            </div>
          </div>
        </div>

        <div class="glass rounded-2xl p-6">
          <div class="flex items-start gap-4">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </span>
            <div>
              <h3 class="font-semibold text-white">Horário</h3>
              <p class="text-sm text-content-secondary">Seg - Sex: 9h às 18h</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var form = document.getElementById('contact-form');
    if (!form) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      
      var name = document.getElementById('name').value;
      var email = document.getElementById('email').value;
      var service = document.getElementById('service').value;
      var message = document.getElementById('message').value;

      var text = 'Olá! Gostaria de um orçamento.\n\n';
      text += '*Nome:* ' + name + '\n';
      text += '*E-mail:* ' + email + '\n';
      if (service) text += '*Serviço:* ' + service + '\n';
      text += '*Mensagem:* ' + message;

      var whatsappUrl = 'https://wa.me/5538999305943?text=' + encodeURIComponent(text);
      window.open(whatsappUrl, '_blank');

      form.reset();
    });
  })();
</script>
