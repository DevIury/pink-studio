---
/* src/components/Cases.astro */
import { Icon } from 'astro-icon/components';
import SectionTitle from './ui/SectionTitle.astro';
import Button from './ui/Button.astro';
import { CASES, LINKS } from '@/config';
---

<section id="cases" class="relative section-padding">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute left-1/4 top-1/3 h-96 w-96 rounded-full bg-accent/6 blur-[130px]"
    />
  </div>

  <div class="container-site relative z-10">
    <SectionTitle
      eyebrow="Cases"
      title="Histórias que já emocionaram."
      description="Cada cliente é uma história única. Conheça algumas das conexões que ajudamos a construir — ou reserve este espaço para a sua."
    />

    <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        CASES.map((caseItem, index) => (
          <article
            class="group flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-base-surface/60 transition-all duration-500 hover:-translate-y-1.5 hover:border-accent/30 hover:shadow-glow"
            data-reveal
            style={`--reveal-delay: ${index * 110}ms`}
          >
            <div class="relative aspect-[3/2] overflow-hidden">
              <img
                src={caseItem.image}
                alt={`Case ${caseItem.client}`}
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-base-bg/70 via-transparent to-transparent"
                aria-hidden="true"
              />
              <span
                class="absolute right-4 top-4 flex items-center gap-1.5 rounded-full border border-white/15 bg-black/40 px-3 py-1.5 text-[10px] font-semibold uppercase tracking-widest text-white backdrop-blur-md"
              >
                <Icon name="play" class="h-3 w-3" aria-hidden="true" />
                Em breve
              </span>
            </div>

            <div class="flex flex-1 flex-col gap-3 p-6">
              <h3 class="text-xl font-bold tracking-tight text-white">
                {caseItem.client}
              </h3>
              <p class="flex-1 text-pretty text-sm leading-relaxed text-content-secondary">
                {caseItem.description}
              </p>
              <Button
                href={LINKS.whatsapp}
                label="Quero um case assim"
                icon="arrow-right"
                size="md"
                variant="ghost"
                class="self-start pl-0 hover:pl-0 group/btn text-accent hover:text-accent-hover"
              />
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-14 flex justify-center" data-reveal>
      <a
        href={LINKS.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 rounded-full bg-gradient-to-r from-accent to-[#1a1a1a] px-8 py-4 text-sm font-bold text-white shadow-glow transition-all duration-300 hover:from-accent-hover hover:to-[#222222] hover:scale-105 active:scale-95"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
        </svg>
        Quero resultados assim
      </a>
    </div>
  </div>
</section>