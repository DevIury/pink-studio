---
/* src/components/Hero.astro */
import { Icon } from 'astro-icon/components';
import Button from './ui/Button.astro';
import { LINKS } from '@/config';
---

<section
  id="inicio"
  class="relative flex min-h-[85svh] items-center overflow-hidden pt-24 pb-14 md:min-h-[70svh] lg:min-h-[80svh] xl:min-h-[100svh] lg:pt-[5.5rem] lg:pb-16"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute -top-40 left-1/2 h-[42rem] w-[42rem] -translate-x-1/2 rounded-full bg-accent/15 blur-[140px] max-md:-top-60 max-md:h-[30rem] max-md:w-[30rem] max-md:blur-[100px] max-md:bg-accent/10"
    />
    <div
      class="absolute top-1/3 -left-40 h-[30rem] w-[30rem] rounded-full bg-[#7c3aed]/10 blur-[130px] animate-float-slow max-md:-left-60 max-md:top-1/4 max-md:h-[22rem] max-md:w-[22rem] max-md:blur-[80px] max-md:bg-[#7c3aed]/8"
    />
    <div
      class="absolute bottom-0 -right-32 h-[26rem] w-[26rem] rounded-full bg-accent/10 blur-[120px] animate-float max-md:-right-48 max-md:bottom-auto max-md:top-[60%] max-md:h-[20rem] max-md:w-[20rem] max-md:blur-[80px] max-md:bg-accent/8"
    />
    <div
      class="absolute inset-0 opacity-[0.05]"
      style="background-image: radial-gradient(circle at 1px 1px, #ffffff 1px, transparent 0); background-size: 56px 56px;"
    />
    <div
      class="absolute inset-0 md:block max-md:hidden"
      style="background-image: radial-gradient(ellipse at center, transparent 0%, var(--color-base-bg, #09090b) 70%);"
    />
    <div
      class="absolute inset-0 hidden max-md:block"
      style="background: radial-gradient(ellipse at 50% 30%, transparent 0%, #09090b 60%);"
    />
    <div class="noise-overlay" />
  </div>

  <div class="container-site relative z-10 grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-10">
    <div class="flex flex-col items-start">
      <span
        class="hero-animate hero-animate-delay-1 inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-content-secondary backdrop-blur-xl"
      >
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"
          />
          <span class="relative inline-flex h-2 w-2 rounded-full bg-accent" />
        </span>
        Curvelo – MG
      </span>

      <h1
        class="hero-animate hero-animate-delay-2 mt-6 max-w-3xl text-balance text-4xl font-extrabold leading-[1.08] tracking-tight text-white sm:text-5xl md:text-[2.75rem] lg:text-6xl xl:text-7xl"
      >
        Histórias que
        <span class="text-gradient">conectam pessoas</span>
        de verdade.
      </h1>

      <p
        class="hero-animate hero-animate-delay-3 mt-5 max-w-xl text-pretty text-base leading-relaxed text-content-secondary md:text-lg"
      >
        Somos especialistas em transformar momentos, empresas e marcas em
        histórias capazes de gerar conexão, autoridade e resultados através do
        audiovisual.
      </p>

      <div
        class="hero-animate hero-animate-delay-4 mt-8 flex flex-wrap items-center gap-3"
      >
        <Button
          href={LINKS.whatsapp}
          label="Começar pelo WhatsApp"
          icon="fa6-brands:whatsapp"
          iconPosition="left"
          size="lg"
        />
      </div>
    </div>

    <div
      class="hero-animate hero-animate-delay-4 relative hidden items-center justify-center lg:flex"
    >
      <div class="relative w-full max-w-lg">
        <div
          class="absolute -inset-8 rounded-[3rem] bg-gradient-to-tr from-accent/30 via-[#7c3aed]/20 to-transparent blur-3xl"
          aria-hidden="true"
        />

        <div class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-gradient-to-b from-base-surface to-[#141417] shadow-2xl shadow-black/50">
          <div class="relative flex items-center justify-center p-10 md:p-14">
            <picture>
              <source srcset="/logo-clara.avif" type="image/avif" />
              <source srcset="/logo-clara.webp" type="image/webp" />
              <img
                src="/logo-clara.png"
                alt="Logo da Pink Studio"
                class="h-auto w-full max-w-xs object-contain md:max-w-sm"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </picture>
            <div
              class="pointer-events-none absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-base-bg/40 to-transparent"
              aria-hidden="true"
            />
          </div>

          <div class="flex items-center justify-between border-t border-white/10 px-7 py-4">
            <div>
              <p class="text-sm font-bold text-white">Pink Studio</p>
              <p class="text-xs text-content-secondary">Audiovisual & Marketing</p>
            </div>
            <span
              class="flex items-center gap-1.5 text-[10px] font-semibold uppercase tracking-widest text-accent"
            >
              <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
              Histórias que conectam
            </span>
          </div>
        </div>

        <div
          class="glass absolute -left-12 top-10 flex items-center gap-3 rounded-2xl p-3.5 pr-5 animate-float"
        >
          <span
            class="flex h-11 w-11 items-center justify-center rounded-xl bg-accent/15 text-accent"
          >
            <Icon name="zap" class="h-5 w-5" />
          </span>
          <div class="flex flex-col">
            <span class="text-sm font-bold text-white">Storymaker</span>
            <span class="text-[11px] text-content-secondary">Cobertura em tempo real</span>
          </div>
        </div>

        <div
          class="glass absolute -right-10 bottom-14 flex items-center gap-3 rounded-2xl p-3.5 pr-5 animate-float-slow"
        >
          <span
            class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#7c3aed]/15 text-[#b18cff]"
          >
            <Icon name="clapperboard" class="h-5 w-5" />
          </span>
          <div class="flex flex-col">
            <span class="text-sm font-bold text-white">Videomaker</span>
            <span class="text-[11px] text-content-secondary">Histórias para o feed</span>
          </div>
        </div>

        <div
          class="glass absolute -bottom-5 left-10 flex items-center gap-2.5 rounded-full px-5 py-2.5 animate-float"
          style="animation-delay: 1.5s"
        >
          <Icon name="heart" class="h-4 w-4 text-accent" />
          <span class="text-xs font-semibold text-white">100% conexão humana</span>
        </div>
      </div>
    </div>
  </div>

  <div
    class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-base-bg to-transparent"
    aria-hidden="true"
  />
</section>