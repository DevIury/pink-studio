---
/* src/components/Testimonials.astro */
import { Icon } from 'astro-icon/components';
import SectionTitle from './ui/SectionTitle.astro';
import Button from './ui/Button.astro';
import { TESTIMONIALS, LINKS } from '@/config';
---

<section
  id="depoimentos"
  class="relative overflow-hidden section-padding"
>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute right-1/4 top-0 h-96 w-96 rounded-full bg-accent/8 blur-[130px]"
    />
  </div>

  <div class="container-site relative z-10">
    <SectionTitle
      eyebrow="Depoimentos"
      title="O que sentem quem já confiou."
      description="A emoção de quem viveu uma história contada pela Pink — em primeira pessoa."
    />

    <div class="relative mx-auto mt-16 max-w-3xl">
      <div
        class="pointer-events-none absolute -top-8 left-0 z-0 text-8xl text-accent/15 md:-left-8"
        aria-hidden="true"
      >
        <Icon name="quote" class="h-16 w-16" />
      </div>

      <div class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-base-surface/60 p-8 backdrop-blur-sm md:p-12">
        <div id="testimonial-track" class="overflow-hidden">
          <div
            id="testimonial-slides"
            class="flex transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)]"
          >
            {
              TESTIMONIALS.map((t) => (
                <figure
                  class="w-full shrink-0 px-1 text-center"
                  aria-label="Depoimento de cliente"
                >
                  <blockquote class="text-pretty text-xl font-medium leading-relaxed text-white md:text-2xl">
                    “{t.text}”
                  </blockquote>
                  <figcaption class="mt-8 flex flex-col items-center gap-3">
                    <img
                      src={t.photo}
                      alt={`Foto de ${t.name}`}
                      width="64"
                      height="64"
                      class="h-16 w-16 rounded-full border-2 border-accent/40 object-cover shadow-glow-sm"
                      loading="lazy"
                    />
                    <div>
                      <p class="font-bold text-white">{t.name}</p>
                      <p class="text-sm text-content-secondary">{t.company}</p>
                    </div>
                  </figcaption>
                </figure>
              ))
            }
          </div>
        </div>

        <div class="mt-10 flex items-center justify-center gap-6">
          <button
            id="prev-slide"
            type="button"
            class="flex h-11 w-11 items-center justify-center rounded-full glass text-white transition-all duration-300 hover:border-accent/40 hover:bg-white/10 hover:-translate-x-0.5"
            aria-label="Depoimento anterior"
          >
            <Icon name="arrow-right" class="h-4 w-4 rotate-180" aria-hidden="true" />
          </button>

          <div id="dots" class="flex items-center gap-2" role="tablist" aria-label="Navegação de depoimentos"></div>

          <button
            id="next-slide"
            type="button"
            class="flex h-11 w-11 items-center justify-center rounded-full glass text-white transition-all duration-300 hover:border-accent/40 hover:bg-white/10 hover:translate-x-0.5"
            aria-label="Próximo depoimento"
          >
            <Icon name="arrow-right" class="h-4 w-4" aria-hidden="true" />
          </button>
        </div>
      </div>
    </div>

    <div
      class="relative mt-14 overflow-hidden rounded-3xl border border-accent/20 bg-gradient-to-br from-accent/10 via-base-surface to-accent/5 p-10 text-center"
      data-reveal
    >
      <div class="noise-overlay rounded-3xl" aria-hidden="true" />
      <div class="relative z-10 flex flex-col items-center gap-5">
        <p class="text-lg font-medium text-white md:text-xl">
          Sua marca pode ser a próxima história.
        </p>
        <a
          href={LINKS.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 rounded-full bg-gradient-to-r from-accent to-[#1a1a1a] px-8 py-4 text-sm font-bold text-white shadow-glow transition-all duration-300 hover:from-accent-hover hover:to-[#222222] hover:scale-105 active:scale-95"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          Quero um depoimento desses
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate } from 'motion';

  const slides = document.getElementById('testimonial-slides') as HTMLElement;
  const dotsContainer = document.getElementById('dots') as HTMLElement;
  const prevButton = document.getElementById('prev-slide') as HTMLButtonElement;
  const nextButton = document.getElementById('next-slide') as HTMLButtonElement;
  const total = slides.children.length;

  let current = 0;
  let timer: ReturnType<typeof setInterval> | undefined;

  function buildDots() {
    dotsContainer.innerHTML = '';
    for (let i = 0; i < total; i++) {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.setAttribute('aria-label', `Ir para depoimento ${i + 1}`);
      dot.className =
        'h-2 rounded-full bg-white/20 transition-all duration-300 hover:bg-white/40';
      dot.style.width = '8px';
      dot.addEventListener('click', () => goTo(i));
      dotsContainer.appendChild(dot);
    }
  }

  function updateDots() {
    Array.from(dotsContainer.children).forEach((dot, i) => {
      if (i === current) {
        dot.className =
          'h-2 rounded-full bg-accent shadow-glow-sm transition-all duration-300';
        dot.style.width = '28px';
        dot.setAttribute('aria-current', 'true');
      } else {
        dot.className =
          'h-2 rounded-full bg-white/20 transition-all duration-300 hover:bg-white/40';
        dot.style.width = '8px';
        dot.removeAttribute('aria-current');
      }
    });
  }

  async function goTo(index: number) {
    current = (index + total) % total;
    await animate(
      slides,
      { x: `-${current * 100}%` },
      { duration: 0.7, ease: [0.22, 1, 0.36, 1] },
    );
    updateDots();
  }

  function startAuto() {
    stopAuto();
    timer = setInterval(() => goTo(current + 1), 6000);
  }

  function stopAuto() {
    if (timer) clearInterval(timer);
  }

  prevButton.addEventListener('click', () => {
    goTo(current - 1);
    startAuto();
  });
  nextButton.addEventListener('click', () => {
    goTo(current + 1);
    startAuto();
  });

  const container = slides.closest('.relative');
  container?.addEventListener('mouseenter', stopAuto);
  container?.addEventListener('mouseleave', startAuto);
  container?.addEventListener('focusin', stopAuto);
  container?.addEventListener('focusout', startAuto);

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduceMotion) {
    stopAuto();
    const sheet = new CSSStyleSheet();
    sheet.replaceSync('#testimonial-slides { transition: none !important; }');
  }

  buildDots();
  updateDots();
  startAuto();
</script>