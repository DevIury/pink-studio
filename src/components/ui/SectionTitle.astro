---
/* src/components/ui/SectionTitle.astro */
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'center' | 'left';
}

const { eyebrow, title, description, align = 'center' } = Astro.props;

const isCenter = align === 'center';
---

<div
  class:list={[
    'relative z-10 flex max-w-3xl flex-col gap-5',
    isCenter ? 'mx-auto items-center text-center' : 'items-start text-left',
  ]}
  data-reveal
>
  {eyebrow && (
    <span
      class:list={[
        'inline-flex items-center gap-2 rounded-full border border-accent/25 bg-accent/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-accent',
        isCenter ? 'self-center' : 'self-start',
      ]}
    >
      <span class="h-1.5 w-1.5 rounded-full bg-accent shadow-glow-sm" aria-hidden="true" />
      {eyebrow}
    </span>
  )}

  <h2 class="text-balance text-4xl font-bold leading-[1.1] tracking-tight text-white md:text-5xl lg:text-6xl">
    {title}
  </h2>

  {description && (
    <p class="max-w-2xl text-pretty text-base leading-relaxed text-content-secondary md:text-lg">
      {description}
    </p>
  )}
</div>