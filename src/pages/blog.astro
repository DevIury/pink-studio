---
/* src/pages/blog.astro */
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import { SITE, LINKS } from '@/config';

const articles = [
  {
    slug: 'por-que-sua-marca-precisa-de-video-profissional',
    category: 'Produção de Vídeo',
    title: 'Por que sua marca precisa de vídeo profissional em 2026',
    excerpt:
      'O consumo de vídeo cresce 100% todo ano. Marcas que não investem em produção profissional estão perdendo espaço — e clientes — para quem conta histórias com qualidade.',
    readTime: '5 min de leitura',
    date: '12 Ago 2026',
    featured: true,
  },
  {
    slug: 'social-media-nao-e-so-postar',
    category: 'Social Media',
    title: 'Social Media não é só postar: como uma estratégia conecta sua marca ao cliente',
    excerpt:
      'Postar sem estratégia é como gritar em um cento escuro. Entenda por que planejamento é a diferença entre likes e vendas.',
    readTime: '4 min de leitura',
    date: '05 Ago 2026',
    featured: false,
  },
  {
    slug: 'storymaker-vs-videomaker',
    category: 'Serviços',
    title: 'Storymaker vs Videomaker: qual a diferença e quando usar cada um',
    excerpt:
      'Muita gente confunde os dois termos, mas são serviços complementares com objetivos diferentes. Descubra qual se encaixa melhor no seu momento.',
    readTime: '6 min de leitura',
    date: '28 Jul 2026',
    featured: false,
  },
];
---

<Layout
  title={`Blog | ${SITE.name}`}
  description="Artigos sobre produção de vídeo, social media e estratégias de marca. Conteúdo exclusivo da Pink Studio para impulsionar sua presença digital."
  canonicalPath="/blog"
>
  <Navbar basePath="/" />
  <main id="conteudo" class="relative pt-32 pb-20 lg:pt-40">
    <!-- Hero Background -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <div
        class="absolute -top-40 left-1/2 h-[42rem] w-[42rem] -translate-x-1/2 rounded-full bg-accent/15 blur-[140px] max-md:-top-60 max-md:h-[30rem] max-md:w-[30rem] max-md:blur-[100px] max-md:bg-accent/10"
      />
      <div
        class="absolute top-1/3 -left-40 h-[30rem] w-[30rem] rounded-full bg-[#7c3aed]/10 blur-[130px] animate-float-slow max-md:-left-60 max-md:top-1/4 max-md:h-[22rem] max-md:w-[22rem] max-md:blur-[80px] max-md:bg-[#7c3aed]/8"
      />
      <div
        class="absolute bottom-0 -right-32 h-[26rem] w-[26rem] rounded-full bg-accent/10 blur-[120px] animate-float max-md:-right-48 max-md:bottom-auto max-md:top-[60%] max-md:h-[20rem] max-md:w-[20rem] max-md:blur-[80px] max-md:bg-accent/8"
      />
      <div
        class="absolute inset-0 opacity-[0.05]"
        style="background-image: radial-gradient(circle at 1px 1px, #ffffff 1px, transparent 0); background-size: 56px 56px;"
      />
      <div
        class="absolute inset-0 md:block max-md:hidden"
        style="background-image: radial-gradient(ellipse at center, transparent 0%, var(--color-base-bg, #09090b) 70%);"
      />
      <div
        class="absolute inset-0 hidden max-md:block"
        style="background: radial-gradient(ellipse at 50% 30%, transparent 0%, #09090b 60%);"
      />
      <div class="noise-overlay" />
    </div>

    <!-- Hero -->
    <section class="container-site relative z-10 mb-16 lg:mb-24">
      <div class="relative" data-reveal>
        <span
          class="absolute -left-4 -top-8 text-[8rem] font-black leading-none text-accent/10 select-none md:-left-8 md:-top-14 md:text-[12rem] lg:text-[16rem]"
          aria-hidden="true"
        >
          /
        </span>
        <div class="relative z-10">
          <span
            class="mb-5 inline-flex items-center gap-2 rounded-full border border-accent/25 bg-accent/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-accent"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-accent shadow-glow-sm" aria-hidden="true" />
            Blog
          </span>
          <h1 class="text-balance text-4xl font-bold leading-[1.1] tracking-tight text-white md:text-5xl lg:text-6xl">
            Conteúdo que
            <span class="text-gradient">move</span>
            sua marca
          </h1>
          <p class="mt-5 max-w-2xl text-pretty text-base leading-relaxed text-content-secondary md:text-lg">
            Artigos sobre produção de vídeo, social media e estratégia digital.
            Escritos por quem vive o audiovisual todos os dias.
          </p>
        </div>
      </div>
    </section>

    <!-- Articles Grid -->
    <section class="container-site">
      <div class="grid gap-6 lg:grid-cols-2 lg:gap-8">
        {
          articles.map((article, i) => (
            <a
              href={`/blog/${article.slug}`}
              class:list={[
                'group relative flex flex-col overflow-hidden rounded-3xl border border-white/[0.06] bg-base-surface transition-all duration-500 hover:border-accent/20 hover:shadow-glow',
                article.featured ? 'lg:row-span-2 blog-featured-border' : '',
              ]}
              data-reveal
              style={`--reveal-delay: ${i * 80}ms`}
            >
              {/* Accent bar top */}
              <div class="h-1 w-full bg-gradient-to-r from-accent/60 via-accent to-accent-hover opacity-0 transition-opacity duration-500 group-hover:opacity-100" />

              <div class:list={[
                'flex flex-1 flex-col p-6 md:p-8',
                article.featured ? 'lg:p-10' : '',
              ]}>
                <div class="mb-4 flex items-center gap-3">
                  <span class="rounded-full border border-accent/20 bg-accent/5 px-3 py-1 text-xs font-semibold text-accent">
                    {article.category}
                  </span>
                  <span class="text-xs text-content-secondary">{article.readTime}</span>
                </div>

                <h2 class:list={[
                  'text-balance font-bold leading-tight tracking-tight text-white transition-colors duration-300 group-hover:text-accent',
                  article.featured
                    ? 'text-2xl md:text-3xl lg:text-4xl'
                    : 'text-xl md:text-2xl',
                ]}>
                  {article.title}
                </h2>

                <p class:list={[
                  'mt-4 flex-1 text-pretty leading-relaxed text-content-secondary',
                  article.featured ? 'text-base md:text-lg' : 'text-sm md:text-base',
                ]}>
                  {article.excerpt}
                </p>

                <div class="mt-6 flex items-center justify-between">
                  <span class="text-xs text-content-secondary">{article.date}</span>
                  <span class="inline-flex items-center gap-2 text-sm font-semibold text-accent transition-all duration-300 group-hover:gap-3">
                    Ler artigo
                    <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 8h10M9 4l4 4-4 4" />
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- CTA -->
    <section class="container-site mt-16 lg:mt-24">
      <div
        class="relative overflow-hidden rounded-3xl border border-accent/20 bg-gradient-to-br from-accent/10 via-base-surface to-accent/5 p-8 md:p-12 lg:p-16"
        data-reveal
      >
        <div class="noise-overlay rounded-3xl" aria-hidden="true" />
        <div class="relative z-10 flex flex-col items-center text-center">
          <h2 class="text-balance text-2xl font-bold tracking-tight text-white md:text-3xl lg:text-4xl">
            Quer contar a história da sua marca?
          </h2>
          <p class="mt-4 max-w-xl text-pretty text-base text-content-secondary md:text-lg">
            A gente transforma sua ideia em conteúdo que conecta, gera autoridade e traz resultados reais.
          </p>
          <a
            href={LINKS.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-8 inline-flex items-center gap-3 rounded-full bg-gradient-to-r from-accent to-[#1a1a1a] px-8 py-4 text-sm font-bold text-white shadow-glow transition-all duration-300 hover:from-accent-hover hover:to-[#222222] hover:scale-105 active:scale-95"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
            </svg>
            Falar com a gente
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
